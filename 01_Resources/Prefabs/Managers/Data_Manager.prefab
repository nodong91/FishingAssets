  questStruct:
  - id: qu_0001
    title: "\uCCAB \uB09A\uC2DC \uC131\uACF5"
    description: "\uB09A\uC2DC\uAC00 \uCC98\uC74C\uC778\uAC00? \uC544\uBB34 \uBB3C\uACE0\uAE30\uB098
      \uD55C\uB9C8\uB9AC \uC7A1\uC544\uC640 \uBD10. \uC2E4\uB825\uC740 \uAC80\uC99D
      \uD574\uC57C \uACA0\uC9C0?"
    client: "\uC0DD\uC120\uAC00\uAC8C \uBC15\uC528"
    deadLine: 3
    needItem: []
    result:
    - us_0001
  - id: qu_0002
    title: "\uB0B4 \uC575\uBB34\uC0C8\uB97C \uCC3E\uC544\uC918."
    description: "\uB0B4 \uCE5C\uAD6C \uC870\uC9C0\uAC00 \uC7A0\uAE50 \uD55C \uB208\uD310
      \uC0AC\uC774\uC5D0 \uC0C8\uC7A5\uC5D0\uC11C \uB098\uAC00 \uBC84\uB838\uC5B4.
      \uC774\uD6C4 \uB450\uBC88\uC9F8 \uC12C\uBC29\uD5A5\uC73C\uB85C \uB0A0\uC544\uAC14\uC5B4.
      \uCC3E\uC544\uC8FC\uBA74 \uBCF4\uC0C1 \uD560\uAED8."
    client: "\uB4B7\uB3D9\uB124 \uC774\uC528"
    deadLine: 3
    needItem:
    - fs_1001
    - fs_1001
    result:
    - fs_1001
    - fs_1001
  - id: qu_0003
    title: "\uC96C\uBE44\uC2A4 \uB2E4\uC774\uC5B4\uD2B8"
    description: "\uC131\uACF5\uC740 \uC5B8\uC81C\uB098\\n\uD55C\uBC88\uC5D0 \uBE60\uB974\uAC8C\\n\uD558\uB098\uC529
      \uBC14\uB974\uAC8C"
    client: "\uAD11\uACE0"
    deadLine: 0
    needItem: []
    result: []
  - id: qu_0004
    title: "\uC5D8\uB9AC\uAC8C\uC774\uD130 \uAC00\uC544"
    description: "\uB0B4\uAC00 \uB09A\uC740 \uC5ED\uB300\uAE09 \uC6D4\uCC99 \uBC30\uC2A4\uB97C
      \uCC44\uAC14\uC5B4. \uC545\uC5B4\uB97C \uB2EE\uC740 \uBB3C\uACE0\uAE30\uC600\uC5B4!!
      \uADF8\uB140\uC11D\uC744 \uC7A1\uC544\uC918. \uBCF5\uC218\uB97C \uD574\uC57C\uACA0\uC5B4!!"
    client: "\uC606\uB3D9\uB124 \uAE40\uC528"
    deadLine: 3
    needItem:
    - fs_1001
    result:
    - fs_1001
    - us_3002
  - id: qu_0005
    title: sadfad
    description: asdfadsf
    client: "\uC606\uB3D9\uB124 \uAE40\uC528"
    deadLine: 3
    needItem:
    - fs_1001
    result:
    - fs_1001
    - us_3002
  languageStruct:
  - id: di_0001_a
    english: I need a {0}
    korean: "{0}\uAC00 \uD544\uC694\uD574"
    japanese: "{0} \u304C \u5FC5\u8981 \u3060"
    chinese: "\u6211 \u9700\u8981 {0}"
  - id: di_0001_b
    english: boat
    korean: "\uBC30"
    japanese: "\u8239"
    chinese: "\u8239"
  - id: di_0001_c
    english: Go to the shipyard
    korean: "\uC870\uC120\uC18C\uB85C \uAC00\uBCF4\uC790."
    japanese: "\u9020\u8239\u6240\u306B \u884C\u3053\u3046"
    chinese: "\u53BB \u8239\u575E \u770B\u770B"
  - id: di_0002_a
    english: Cheer up and let's start over from the beginning
    korean: "\uAE30\uC6B4 \uB0B4\uC11C \uCC98\uC74C\uBD80\uD130 \uB2E4\uC2DC \uAC00\uC790"
    japanese: "\u5143\u6C17 \u3092 \u51FA\u3057\u3066 \u6700\u521D \u304B\u3089 \u3084\u308A\u76F4\u305D\u3046"
    chinese: "\u632F\u4F5C \u8D77\u6765 \u6211\u4EEC \u4ECE\u5934 \u518D \u6765 \u5427"
  - id: di_0002_b
    english: Enter
    korean: "\uB4E4\uC5B4\uAC00\uAE30"
    japanese: "\u5165\u308B"
    chinese: "\u8FDB\u5165"
  - id: di_0003_a
    english: First I need a ship let's go to the shipyard
    korean: "\uC77C\uB2E8 \uBC30\uAC00 \uD544\uC694\uD574. \uC870\uC120\uC18C\uB85C
      \uAC00\uBCF4\uC790."
    japanese: "\u307E\u305A \u8239\u304C \u5FC5\u8981\u3060 \u9020\u8239\u6240\u306B
      \u884C\u3053\u3046"
    chinese: "\u9996\u5148 \u6211 \u9700\u8981 \u8239 \u6211\u4EEC \u53BB \u9020\u8239\u5382
      \u5427"
  - id: di_0004_a
    english: The ship is not moving I need to service the ship
    korean: "\uBC30\uAC00 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC544 \uBC30\uB97C \uC815\uBE44\uD574\uC57C
      \uD574"
    japanese: "\u8239\u304C \u52D5\u304B \u306A\u3044 \u8239\u3092 \u6574\u5099\u3057\u306A\u3051\u308C\u3070\u306A\u3089\u306A\u3044"
    chinese: "\u8239 \u52A8 \u4E0D\u4E86 \u4E86 \u6211 \u9700\u8981 \u68C0\u4FEE
      \u8239\u53EA"
  - id: di_0005_a
    english: The inn was lending money I should go there
    korean: "\uC5EC\uAD00\uC5D0\uC11C \uB3C8\uC744 \uBE4C\uB824\uC8FC\uB358\uB370
      \uAC00\uBD10\uC57C\uACA0\uB2E4."
    japanese: "\u5BBF\u5C4B\u3067 \u304A\u91D1\u3092 \u8CB8\u3057\u3066 \u304F\u308C\u308B
      \u305D\u3046\u3060 \u884C\u3063\u3066 \u307F\u3088\u3046"
    chinese: "\u542C\u8BF4 \u65C5\u9986 \u4F1A \u501F\u94B1 \u7ED9\u6211 \u5F97\u53BB
      \u770B\u770B"
  - id: di_0006_a
    english: It seems it has not opened yet
    korean: "\uC544\uC9C1 \uC5F4\uC9C0 \uC54A\uC740 \uAC83 \uAC19\uB2E4."
    japanese: "\u307E\u3060 \u958B\u3044\u3066 \u3044\u306A\u3044 \u3088\u3046\u3060"
    chinese: "\u597D\u50CF \u8FD8\u6CA1 \u6709 \u5F00\u95E8"
  - id: di_0006_b
    english: Exit
    korean: "\uB098\uAC00\uAE30"
    japanese: "\u51FA\u308B"
    chinese: "\u9000\u51FA"
  - id: di_0007_a
    english: There is {0}
    korean: "{0}\uAC83\uB3C4 \uC5C6\uB2E4."
    japanese: "{0}\u3082 \u306A\u3044"
    chinese: "{0}\u4E48 \u90FD \u6CA1\u6709"
