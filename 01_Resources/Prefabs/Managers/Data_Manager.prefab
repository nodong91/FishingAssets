      \uC6B0\uB9AC \uC12C \uC870\uC120\uC18C \uACE0\uC591\uC774 \uAE30\uC220\uB85C\uB294
      \uBABB\uAC00\"/n\"\uC5B8\uC820\uAC04 \uAC08 \uC218 \uC788\uC9C0 \uC54A\uC744\uAE4C?\"/n\"\uADF8\uBCF4\uB2E4
      \uBB50 \uC880 \uBA39\uC790\""
    japanese: "\"\u4ED6\u306E\u5CF6\u306B\u884C\u3063\u3066\u307F\u305F\u3044\"/n\"\u3046\u3061\u306E\u5CF6\u306E\u9020\u8239\u6240\u732B\u306E\u6280\u8853\u3058\u3083\u307E\u3060\u884C\u3051\u306A\u3044\u3088\"/n\"\u3044\u3064\u304B\u306F\u884C\u3051\u308B\u3093\u3058\u3083\u306A\u3044\u304B\u306A?\"/n\"\u305D\u308C\u3088\u308A\u4F55\u304B\u98DF\u3079\u3088\u3046\""
    chinese: "\"\u6211\u60F3\u53BB\u522B\u7684\u5C9B\"/n\"\u6211\u4EEC\u5C9B\u4E0A\u9020\u8239\u5382\u732B\u54AA\u7684\u6280\u672F\u8FD8\u53BB\u4E0D\u4E86\"/n\"\u603B\u6709\u4E00\u5929\u80FD\u53BB\u7684\u5427?\"/n\"\u6BD4\u8D77\u90A3\u4E2A\u6211\u4EEC\u5148\u5403\u70B9\u4E1C\u897F\u5427\""
