    japanese: "\"\u304A\u3044\u4FFA\u304C\u6CBF\u5CB8\u3067\u4F55\u3092\u898B\u305F\u3068\u601D\u3046?\"/n\"\u4F55\u3092\u898B\u305F\u306E?\"/n{0}\"\u3092\u898B\u305F\u3093\u3060/n\u305D\u308C\u98DF\u3079\u3089\u308C\u308B\u306E?\""
    chinese: "\"\u5582 \u4F60\u731C\u6211\u5728\u6CBF\u5CB8\u770B\u5230\u4E86\u4EC0\u4E48?\"/n\"\u4F60\u770B\u5230\u4E86\u4EC0\u4E48?\"/n\"\u6211\u770B\u5230\u4E86{0}\"/n\"\u90A3\u4E2A\u80FD\u5403\u5417?\""
