  questStruct:
  - id: qu_0001
    title: "\uCCAB \uB09A\uC2DC \uC131\uACF5"
    description: "\uB09A\uC2DC\uAC00 \uCC98\uC74C\uC778\uAC00? \uC544\uBB34 \uBB3C\uACE0\uAE30\uB098
      \uD55C\uB9C8\uB9AC \uC7A1\uC544\uC640 \uBD10. \uC2E4\uB825\uC740 \uAC80\uC99D
      \uD574\uC57C \uACA0\uC9C0?"
    client: "\uC0DD\uC120\uAC00\uAC8C \uBC15\uC528"
    deadLine: 3
    needItem: []
    result:
    - us_0001
  - id: qu_0002
    title: "\uB0B4 \uC575\uBB34\uC0C8\uB97C \uCC3E\uC544\uC918."
    description: "\uB0B4 \uCE5C\uAD6C \uC870\uC9C0\uAC00 \uC7A0\uAE50 \uD55C \uB208\uD310
      \uC0AC\uC774\uC5D0 \uC0C8\uC7A5\uC5D0\uC11C \uB098\uAC00 \uBC84\uB838\uC5B4.
      \uC774\uD6C4 \uB450\uBC88\uC9F8 \uC12C\uBC29\uD5A5\uC73C\uB85C \uB0A0\uC544\uAC14\uC5B4.
      \uCC3E\uC544\uC8FC\uBA74 \uBCF4\uC0C1 \uD560\uAED8."
    client: "\uB4B7\uB3D9\uB124 \uC774\uC528"
    deadLine: 3
    needItem:
    - fs_1001
    - fs_1001
    result:
    - fs_1001
    - fs_1001
  - id: qu_0003
    title: "\uC96C\uBE44\uC2A4 \uB2E4\uC774\uC5B4\uD2B8"
    description: "\uC131\uACF5\uC740 \uC5B8\uC81C\uB098\\n\uD55C\uBC88\uC5D0 \uBE60\uB974\uAC8C\\n\uD558\uB098\uC529
      \uBC14\uB974\uAC8C"
    client: "\uAD11\uACE0"
    deadLine: 0
    needItem: []
    result: []
  - id: qu_0004
    title: "\uC5D8\uB9AC\uAC8C\uC774\uD130 \uAC00\uC544"
    description: "\uB0B4\uAC00 \uB09A\uC740 \uC5ED\uB300\uAE09 \uC6D4\uCC99 \uBC30\uC2A4\uB97C
      \uCC44\uAC14\uC5B4. \uC545\uC5B4\uB97C \uB2EE\uC740 \uBB3C\uACE0\uAE30\uC600\uC5B4!!
      \uADF8\uB140\uC11D\uC744 \uC7A1\uC544\uC918. \uBCF5\uC218\uB97C \uD574\uC57C\uACA0\uC5B4!!"
    client: "\uC606\uB3D9\uB124 \uAE40\uC528"
    deadLine: 3
    needItem:
    - fs_1001
    result:
    - fs_1001
    - us_3002
  - id: qu_0005
    title: sadfad
    description: asdfadsf
    client: "\uC606\uB3D9\uB124 \uAE40\uC528"
    deadLine: 3
    needItem:
    - fs_1001
    result:
    - fs_1001
    - us_3002
  languageStruct:
  - id: di_1001_a
    english: Buy {0}~We have fresh and {1}
    korean: "{0} \uC0AC\uC138\uC694~\uC2E0\uC120\uD558\uACE0 {1}\uC774 \uC788\uC5B4\uC694."
    japanese: "{0} \u3044\u304B\u304C\u3067\u3059\u304B~\u65B0\u9BAE \u3067 {1} \u304C
      \u3042\u308A\u307E\u3059"
    chinese: "\u5FEB\u6765 {0} \u5427~\u8FD9\u91CC \u6709 \u65B0\u9C9C \u53C8 {1}"
  - id: di_1001_b
    english: fish
    korean: "\uC0DD\uC120"
    japanese: "\u304A\u9B5A"
    chinese: "\u4E70\u9C7C"
  - id: di_1001_c
    english: delicious fish
    korean: "\uB9DB\uC788\uB294 \uC0DD\uC120"
    japanese: "\u304A\u3044\u3057\u3044 \u304A\u9B5A"
    chinese: "\u597D\u5403 \u7684 \u9C7C"
  - id: di_1001_e
    english: I want to see the items
    korean: "\uBB3C\uAC74\uC744 \uBCF4\uACE0 \uC2F6\uC5B4"
    japanese: "\u54C1\u7269 \u3092 \u898B\u305F\u3044"
    chinese: "\u6211\u60F3 \u770B\u770B \u7269\u54C1"
  - id: di_1001_d
    english: Welcome buy fresh fish
    korean: "\uBC18\uAC00\uC6CC\uC694. \uC2E0\uC120\uD55C \uC0DD\uC120 \uC0AC\uAC00\uC138\uC694."
    japanese: "\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u305B \u65B0\u9BAE \u306A
      \u9B5A \u3092 \u8CB7\u3063\u3066 \u3044\u3063\u3066\u304F\u3060\u3055\u3044"
    chinese: "\u6B22\u8FCE \u5149\u4E34 \u8BF7 \u4E70 \u65B0\u9C9C \u7684 \u9C7C"
  - id: di_2001_a
    english: '{0}look who it is What''s going on today?'
    korean: "{0}\uC774\uAC8C \uB204\uAD6C\uC57C \uC624\uB298\uC740 \uBB34\uC2A8 \uC77C\uC774\uC9C0?"
    japanese: "{0}\u3053\u308C\u306F \u8AB0 \u3067\u3059\u304B \u4ECA\u65E5 \u306F
      \u3069\u3046\u3057\u307E\u3057\u305F\u304B"
    chinese: "{0}\u8FD9\u662F \u8C01\u5440 \u4ECA\u5929 \u6709 \u4EC0\u4E48 \u4E8B
      \u5417"
  - id: di_2001_b
    english: Well~
    korean: "\uC624~"
    japanese: "\u304A\u3084~"
    chinese: "\u54E6~"
  - id: di_2001_c
    english: I want to buy an item
    korean: "\uBB3C\uAC74\uC744 \uC0AC\uACE0 \uC2F6\uC5B4"
    japanese: "\u7269\u3092 \u8CB7\u3044\u305F\u3044"
    chinese: "\u6211\u60F3 \u4E70 \u4E1C\u897F"
  - id: di_2001_d
    english: I want to upgrade my ship
    korean: "\uBC30\uB97C \uAC15\uD654\uD558\uACE0 \uC2F6\uC5B4"
    japanese: "\u8239 \u3092 \u5F37\u5316 \u3057\u305F\u3044"
    chinese: "\u6211\u60F3 \u5F3A\u5316 \u8239"
  - id: di_2002_a
    english: First go and repair the ship...If you try to {0}it like this everything
      will be destroyed
    korean: "\uC77C\uB2E8 \uBC30\uBD80\uD130 \uACE0\uCE58\uACE0 \uC624\uAC8C...\uC774\uB300\uB85C
      {0} \uD558\uB2E4\uAC04 \uBAA8\uB450 \uBD80\uC11C\uC838 \uBC84\uB9B4\uAC70\uC57C."
    japanese: "\u5148\u306B \u8239 \u3092 \u4FEE\u7406 \u3057\u3066 \u304F\u3060\u3055\u3044...\u3053\u306E
      \u72B6\u614B \u3067 {0}\u3059\u308B\u3068 \u5168\u90E8 \u5D29\u58CA \u3057\u307E\u3059"
    chinese: "\u5148 \u53BB \u4FEE\u7406 \u8239\u5427...\u8FD9\u6837 \u7EE7\u7EED
      {0} \u4F1A \u5168\u90FD \u6BC1\u6389 \u7684"
  - id: di_2002_b
    english: upgrade
    korean: "\uAC15\uD654"
    japanese: "\u5F37\u5316"
    chinese: "\u5F3A\u5316"
  - id: di_2002_c
    english: End of conversation
    korean: "\uB300\uD654 \uB9C8\uCE68"
    japanese: "\u4F1A\u8A71 \u7D42\u4E86"
    chinese: "\u5BF9\u8BDD \u7ED3\u675F"
  - id: di_2003_a
    english: Do you need a ship?
    korean: "\uBC30\uAC00 \uD544\uC694\uD55C\uAC00?"
    japanese: "\u8239 \u304C \u5FC5\u8981 \u3067\u3059\u304B?"
    chinese: "\u9700\u8981 \u8239 \u5417?"
  - id: di_2003_b
    english: I only have {0}ship right now
    korean: "\uC9C0\uAE08\uC740 \uBC30\uAC00 {0}\uBC16\uC5D0 \uC5C6\uC5B4."
    japanese: "\u4ECA \u306F \u8239 \u304C {0}\u3057\u304B \u306A\u3044"
    chinese: "\u73B0\u5728 \u53EA\u6709 {0} \u8239"
  - id: di_2003_c
    english: one
    korean: "\uD558\uB098"
    japanese: "\u4E00\u96BB"
    chinese: "\u4E00\u8258"
  - id: di_2003_d
    english: And do not strain yourself looking around at various things The ship
      will not depart without {0}
    korean: "\uADF8\uB9AC\uACE0 \uBB34\uB9AC\uD574\uC11C \uC774\uAC83\uC800\uAC83
      \uAD6C\uACBD\uD558\uC9C0 \uB9D0\uC544. {0}\uAC00 \uC5C6\uC73C\uBA74 \uBC30\uB294
      \uCD9C\uBC1C\uD558\uC9C0 \uC54A\uB294\uB2E4\uAD6C."
    japanese: "\u305D\u308C\u3068 \u7121\u7406 \u3057\u3066 \u8272\u3005 \u898B\u3066
      \u56DE\u308B \u306A {0}\u304C \u7121\u3051\u308C\u3070 \u8239 \u306F \u51FA\u767A
      \u3057\u306A\u3044 \u305E"
    chinese: "\u8FD8\u6709 \u4E0D\u8981 \u52C9\u5F3A \u56DB\u5904 \u53C2\u89C2 \u6CA1\u6709
      {0}\u8239 \u662F \u4E0D\u4F1A \u51FA\u53D1 \u7684"
  - id: di_2003_e
    english: fuel
    korean: "\uC5F0\uB8CC"
    japanese: "\u71C3\u6599"
    chinese: "\u71C3\u6599"
  - id: di_2003_f
    english: Come this way
    korean: "\uC774\uCABD\uC73C\uB85C \uC624\uB77C\uAD6C."
    japanese: "\u3053\u3063\u3061 \u306B \u6765\u3044"
    chinese: "\u5230 \u8FD9\u8FB9 \u6765"
  - id: di_3001_a
    english: Stay and have a drink
    korean: "\uC220 \uD55C \uC794 \uD558\uACE0 \uAC00\uC138\uC694."
    japanese: "\u304A \u9152 \u3067\u3082 \u98F2\u3093\u3067 \u884C\u304D\u307E\u305B\u3093\u304B"
    chinese: "\u7559 \u4E0B\u6765 \u559D \u4E00\u676F \u5427"
  - id: di_3001_b
    english: Just so happens I got some good liquor in
    korean: "\uB9C8\uCE68 \uC88B\uC740 \uC220\uC774 \uB4E4\uC5B4 \uC654\uAC70\uB4E0\uC694."
    japanese: "\u3061\u3087\u3046\u3069 \u826F\u3044 \u304A\u9152 \u304C \u5165\u8377
      \u3057\u305F \u3093\u3067\u3059\u3088"
    chinese: "\u6B63\u597D \u8FDB \u4E86 \u4E9B \u597D\u9152"
  - id: di_3001_c
    english: I am tired so I will rest for a bit before I leave
    korean: "\uD53C\uACE4\uD558\uB2C8 \uC880 \uC26C\uB2E4 \uAC08\uAED8."
    japanese: "\u75B2\u308C\u305F \u306E\u3067 \u5C11\u3057 \u4F11\u3093\u3067 \u304B\u3089
      \u5E30\u308A\u307E\u3059"
    chinese: "\u6709\u70B9 \u75B2\u5026 \u6240\u4EE5 \u6B47\u4F1A \u513F \u518D \u79BB\u5F00"
  - id: di_3001_d
    english: Can I borrow some money
    korean: "\uB3C8\uC744 \uBE4C\uB9B4 \uC218 \uC788\uC744\uAE4C."
    japanese: "\u304A\u91D1 \u3092 \u501F\u308A\u308B \u3053\u3068 \u304C \u3067\u304D\u307E\u3059\u304B"
    chinese: "\u53EF\u4EE5 \u501F \u6211 \u70B9\u513F \u94B1 \u5417"
  - id: di_3002_a
    english: I can lend it but you have to return it within {0}
    korean: "\uBE4C\uB824 \uC904 \uC218\uB294 \uC788\uC9C0\uB9CC {0} \uB0B4\uB85C
