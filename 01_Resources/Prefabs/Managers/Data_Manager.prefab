    english: '"I heard there''s a {0}"/n"Nah don''t lie"/n"The cat from the blue
      house fished it out of the great ocean"/n"I wonder if we can eat it?"'
    korean: "\"{0}\uAC00 \uC788\uB2E4\uB354\uB77C\"/n\"\uC5D0\uC774 \uAC70\uC9D3\uB9D0
      \uD558\uC9C0\uB9C8\"/n\"\uD30C\uB780\uC9D1 \uACE0\uC591\uC774\uAC00 \uB300\uC591\uC5D0\uC11C
      \uADF8\uAC78 \uB09A\uC558\uB300\"/n\"\uBA39\uC744 \uC218 \uC788\uB294\uAC78\uAE4C?\""
    japanese: "\"{0}\u304C\u3042\u308B\u3089\u3057\u3044\u3088\"/n\"\u3048\u3048\u5618\u3064\u304F\u306A\u3088\"/n\"\u9752\u3044\u5BB6\u306E\u732B\u304C\u305D\u308C\u3092\u5927\u6D0B\u3067\u91E3\u308A\u4E0A\u3052\u305F\u3093\u3060\u3063\u3066\"/n\"\u98DF\u3079\u3089\u308C\u308B\u306E\u304B\u306A?\""
    chinese: "\"\u6211\u542C\u8BF4\u6709{0}\"/n\"\u54CE \u522B\u8BF4\u8C0E\u4E86\"/n\"\u84DD\u623F\u5B50\u7684\u732B\u5728\u5927\u6D0B\u91CC\u9493\u5230\u4E86\u90A3\u4E2A\"/n\"\u80FD\u5403\u5417?\""
