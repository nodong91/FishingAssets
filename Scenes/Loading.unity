      propertyPath: languageStruct.Array.data[255].korean
      value: "\uB300\uC655\uC624\uC9D5\uC5B4\uB294 \uAE38\uC774 13\uBBF8\uD130 \uC774\uC0C1\uC5D0
        \uB2EC\uD558\uACE0 \uC9C0\uAD6C\uC0C1\uC5D0\uC11C \uAC00\uC7A5 \uD070 \uB208\uC744
