      value: "\uB18D\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[129].korean
      value: ' known for its mild'
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[130].korean
      value: "\uAC00\uC790\uBBF8"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[131].korean
      value: "\uBAB8\uC774 \uB0A9\uC791\uD558\uACE0 \uB450 \uB208\uC774 \uD55C\uCABD\uC73C\uB85C
        \uBAB0\uB824 \uBAA8\uB798\uB098 \uC9C4\uD759 \uBC14\uB2E5\uC5D0 \uC228\uC5B4
        \uC0AC\uB294 \uBB3C\uACE0\uAE30\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[132].korean
      value: "\uC22D\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[133].korean
      value: "\uC804 \uC138\uACC4\uC758 \uB530\uB73B\uD55C \uBC14\uB2E4\uC640 \uAC15
        \uD558\uAD6C\uC5D0 \uC0B4\uBA70 \uBB3C \uC704\uB85C \uC798 \uB6F0\uC5B4\uC624\uB974\uACE0
        \uC2DD\uC6A9\uC73C\uB85C \uC778\uAE30 \uC788\uB294 \uC7A1\uC2DD\uC131 \uD68C\uC720
        \uC5B4\uC885\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[134].korean
      value: "\uBE14\uB8E8\uD0F1"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[135].korean
      value: "\uB208\uBD80\uC2E0 \uCF54\uBC1C\uD2B8\uBE14\uB8E8 \uBAB8\uACFC \uB178\uB780
        \uAF2C\uB9AC \uC9C0\uB290\uB7EC\uBBF8\uB97C \uAC00\uC9C4 \uD654\uB824\uD55C
        \uC5F4\uB300\uC5B4\uB85C \uAF2C\uB9AC \uBBF8\uBCD1\uBD80\uC5D0 \uB0A0\uCE74\uB85C\uC6B4
        \uAC00\uC2DC\uB97C \uC228\uAE30\uACE0 \uC788\uB294 \uAC83\uC774 \uD2B9\uC9D5\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[136].korean
      value: "\uD770\uB3D9\uAC00\uB9AC"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[137].korean
      value: "\uC8FC\uD669\uC0C9 \uBAB8\uC5D0 \uD770\uC0C9 \uC904\uBB34\uB2AC\uAC00
        \uC788\uB294 \uC5F4\uB300\uC5B4\uB85C \uB9D0\uBBF8\uC798\uC758 \uB3C5\uCE68\uC73C\uB85C\uBD80\uD130
        \uBCF4\uD638\uBC1B\uC73C\uBA70 \uACF5\uC0DD\uD558\uACE0 \uC554\uCEF7\uC774
        \uC8FD\uC73C\uBA74 \uAC00\uC7A5 \uD070 \uC218\uCEF7\uC774 \uC554\uCEF7\uC73C\uB85C
        \uC131\uC804\uD658\uD558\uB294 \uB3C5\uD2B9\uD55C \uD2B9\uC9D5\uC744 \uAC00\uC9D1\uB2C8\uB2E4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[138].korean
      value: "\uAF41\uC9C0\uAC00\uC624\uB9AC"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[139].korean
      value: "\uB178\uB780\uC0C9 \uBAB8\uD1B5\uC5D0 \uC120\uBA85\uD55C \uD30C\uB780\uC0C9
        \uC810 \uBB34\uB2AC\uAC00 \uD2B9\uC9D5\uC774\uBA70 \uAF2C\uB9AC\uC5D0 \uB3C5\uCE68\uC774
        \uC788\uACE0 \uC5F4\uB300 \uBC0F \uC544\uC5F4\uB300 \uD574\uC5ED\uC758 \uC0B0\uD638\uCD08\uB098
        \uC595\uC740 \uBAA8\uB798\uBC14\uB2E5\uC5D0 \uC8FC\uB85C \uC11C\uC2DD\uD569\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[140].korean
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[160].korean
      value: "\uBB38\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[161].korean
      value: "8\uAC1C\uC758 \uD314\uACFC 3\uAC1C\uC758 \uC2EC\uC7A5\uC744 \uAC00\uC84C\uC73C\uBA70
        \uB6F0\uC5B4\uB09C \uC9C0\uB2A5\uACFC \uC704\uC7A5\uC220\uB85C \uBC14\uB2F7\uC18D\uC5D0\uC11C
        \uD3EC\uC2DD\uC790\uB97C \uD53C\uD558\uACE0 \uC0AC\uB0E5\uD558\uB294 \uC5F0\uCCB4\uB3D9\uBB3C\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[162].korean
      value: "\uB300\uC655\uACF0\uCE58"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[163].korean
      value: "\uC138\uACC4\uC5D0\uC11C \uAC00\uC7A5 \uD070 \uACF0\uCE58\uB85C \uBAB8\uAE38\uC774
        \uCD5C\uB300 3m \uC774\uC0C1 \uAC15\uD55C \uD131\uACFC \uB0A0\uCE74\uB85C\uC6B4
        \uC774\uBE68\uC744 \uAC00\uC9C4 \uC0B0\uD638\uCD08 \uC0DD\uD0DC\uACC4\uC758
        \uCD5C\uC0C1\uC704 \uC57C\uD589\uC131 \uD3EC\uC2DD\uC790\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[164].korean
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[214].korean
      value: "\uBC29\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[215].korean
      value: "\uC804 \uC138\uACC4 \uC628\uB300 \uBC0F \uC5F4\uB300 \uD574\uC5ED\uC5D0
        \uC11C\uC2DD\uD558\uB294 \uB300\uD615 \uD3EC\uC2DD\uC131 \uC5B4\uC885\uC73C\uB85C
        \uAC15\uD55C \uD798 \uB54C\uBB38\uC5D0 \uB09A\uC2DC\uAFBC\uB4E4\uC5D0\uAC8C
        \uC778\uAE30\uAC00 \uB9CE\uC73C\uBA70 \uD55C\uAD6D\uC5D0\uC11C\uB294 \uACA8\uC6B8\uCCA0
        \uB300\uBC29\uC5B4\uAC00 \uACE0\uAE09 \uC2DD\uC7AC\uB8CC\uB85C \uC778\uAE30\uAC00
        \uB192\uC2B5\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[216].korean
      value: "\uAC1C\uBCF5\uCE58"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[217].korean
      value: "\uAC1C\uBCF5\uCE58\uB294 \uAF2C\uB9AC \uB300\uC2E0 \uD0A4\uC7A1\uC774
        \uC5ED\uD560\uC744 \uD558\uB294 \uD074\uB77C\uBD80\uC2A4\uB97C \uAC00\uC84C\uACE0
        \uBAB8\uC5D0 \uAE30\uC0DD\uD558\uB294 \uC218\uB9CE\uC740 \uAE30\uC0DD\uCDA9\uC744
        \uC5C6\uC560\uAE30 \uC704\uD574 \uC218\uBA74\uC5D0\uC11C \uC77C\uAD11\uC695\uC744
        \uD558\uAC70\uB098 \uC810\uD504\uD558\uB294 \uD2B9\uC774\uD55C \uD589\uB3D9\uC744
        \uBCF4\uC774\uB294 \uBB3C\uACE0\uAE30\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[218].korean
      value: "\uAC08\uCE58"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[219].korean
      value: "\uAC08\uCE58\uB294 \uCE7C\uCC98\uB7FC \uAE38\uACE0 \uB0A9\uC791\uD55C
