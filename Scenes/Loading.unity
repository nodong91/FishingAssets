      value: "\uC544\uAE4C\uBCF4\uB2E4 \uB354 \uBE60\uB974\uAC8C \uB3C4\uB9DD\uCCD0
        \uBC84\uB824\uC11C \uB193\uCCD0\uBC84\uB838\uB2E4./n\uADF8\uB140\uC11D\uC774
        \uC0AC\uB77C\uC9C4 \uAE38 \uC704\uC5D0 \uC8FC\uBA38\uB2C8\uAC00 \uB5A8\uC5B4\uC838\uC788\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[64].korean
      value: "\uAC00\uC838\uAC04\uB2E4."
