    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[65].korean
      value: "\uADF8 \uACE0\uC591\uC774\uB294 \uAC78\uC74C\uC744 \uBA48\uCD94\uACE0
        \uB3CC\uC544\uBCF4\uBA70 \uD65C\uC9DD \uC6C3\uB354\uB2C8/n{0} \uB77C\uBA70
        \uAC00\uBC29 \uC548\uC758 \uBB3C\uAC74\uC744 \uC9C4\uC5F4\uD55C\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[66].korean
      value: "\uC190\uB2D8\uC774\uC168\uAD70\uC694!"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[67].korean
      value: "\uBB3C\uAC74\uC744 \uB458\uB7EC \uBCF8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[68].korean
      value: "\uAD00\uC2EC\uC5C6\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[69].korean
      value: "\"\uB530\uB77C\uAC00 \uBCF4\uB2C8 {0}\uC744 \uBA54\uACE0 \uC788\uB294
        \uACE0\uC591\uC774\uAC00 \uAC00\uC05C \uC228\uC744 \uBAB0\uC544\uC26C\uBA70
        \uBB3C\uC5B4\uBCF8\uB2E4./n\"\"\uB108 \uD639\uC2DC {1}\uC774\uC57C?\"\"\""
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[70].korean
      value: "\uAC70\uB300\uD55C \uAC00\uBC29"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[71].korean
      value: "\uACBD\uCC30"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[72].korean
      value: "\uAF3C\uC9DD\uB9C8! \uC6C0\uC9C1\uC774\uBA74 \uD560\uD038\uB2E4!"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[73].korean
      value: "\uC544\uB2C8\uC57C!"
