    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[74].korean
      value: "{0}\uC740 \uADF8\uB300\uB85C \uC5B4\uB460 \uC18D\uC73C\uB85C \uC0AC\uB77C\uC84C\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[75].korean
      value: "\uB3CC\uC544\uAC04\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[76].korean
      value: "\uC8FC\uBCC0\uC774 \uC18C\uB780\uC2A4\uB7EC\uC6CC\uC9C0\uC790 \uBE60\uB974\uAC8C
        \uC0AC\uB77C\uC838 \uBC84\uB838\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[77].korean
      value: "\uC5B4\uB460 \uC18D\uC758 \uB208\uB3D9\uC790"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[78].korean
      value: "\uB2F9\uC2E0\uC740 \uACE8\uBAA9\uAE38 \uC5B4\uB460 \uC18D\uC5D0\uC11C
        {0}\uC744 \uBCF4\uC558\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[79].korean
      value: "\uBE5B\uB098\uB294 \uB208\uB3D9\uC790"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[80].korean
      value: "\uD655\uC778\uD574 \uBD10\uC57C\uACA0\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[81].korean
      value: "\uBABB \uBCF8 \uCC99\uD558\uACE0 \uC9C0\uB098\uAC04\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[82].korean
      value: "\uD070 \uC18C\uB9AC\uB85C \uC0C1\uD669\uC744 \uC54C\uB9B0\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[83].korean
      value: "\uC870\uC6A9\uD55C \uAC70\uB9AC\uB294 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[84].korean
      value: "\uBA78\uCE58"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[85].korean
      value: "\uBA78\uCE58\uB294 \uC804 \uC138\uACC4\uC801\uC73C\uB85C \uC2DD\uD488\uACFC
        \uBBF8\uB07C\uB85C \uC0C1\uC5C5\uC801 \uC911\uC694\uC131\uC774 \uD06C\uACE0
        \uBA39\uC774 \uC0AC\uC2AC\uC758 \uD575\uC2EC \uACE0\uB9AC \uC5ED\uD560\uC744
        \uD558\uB294 \uC791\uC740 \uBB34\uB9AC \uC0DD\uD65C \uC5B4\uB958\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[86].korean
      value: "\uACE0\uB4F1\uC5B4"
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[87].korean
      value: "\uB4F1\uD478\uB978 \uC0DD\uC120\uC758 \uB300\uD45C \uC8FC\uC790\uB85C
        DHA\uC640 EPA\uAC00 \uD48D\uBD80\uD558\uBA70 \uACC4\uC808\uACFC \uC218\uC628\uC5D0
        \uB530\uB77C \uB0A8\uBD81\uC73C\uB85C \uB300\uADDC\uBAA8 \uBB34\uB9AC\uB97C
        \uC9C0\uC5B4 \uD68C\uC720\uD558\uB294 \uC5B4\uC885\uC785\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5173840136924355948, guid: bcd6edcc8f31d4848951557c4c367459, type: 3}
      propertyPath: languageStruct.Array.data[88].korean
